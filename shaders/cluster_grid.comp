#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct ClusterAABB {
    vec4 minPoint;
    vec4 maxPoint;
};

layout(set = 0, binding = 0) buffer ClusterBuffer {
    ClusterAABB clusters[];
};

layout(push_constant) uniform PushConstants {
    mat4 inverseProj;
    uvec4 gridDimensions; // x,y,z, w=pad
    vec2 screenSize;
    float zNear;
    float zFar;
} pc;

vec4 clipToView(vec4 clip) {
    vec4 view = pc.inverseProj * clip;
    view /= view.w;
    return view;
}

vec4 lineIntersectionToZPlane(vec3 a, vec3 b, float zDistance) {
    vec3 normal = vec3(0.0, 0.0, 1.0); // Wait, zDistance is negative, normal is +Z. dot(normal, a) = a.z.
    vec3 ab = b - a;
    float t = (zDistance - a.z) / ab.z;
    return vec4(a + t * ab, 1.0);
}

void main() {
    uint tileIndex = gl_GlobalInvocationID.x +
                     gl_GlobalInvocationID.y * pc.gridDimensions.x +
                     gl_GlobalInvocationID.z * pc.gridDimensions.x * pc.gridDimensions.y;
                     
    vec2 tileSize = vec2(pc.screenSize.x / float(pc.gridDimensions.x),
                         pc.screenSize.y / float(pc.gridDimensions.y));
                         
    vec2 minPx = vec2(gl_GlobalInvocationID.xy) * tileSize;
    vec2 maxPx = vec2(gl_GlobalInvocationID.xy + vec2(1.0)) * tileSize;
    
    vec2 minNDC = (minPx / pc.screenSize) * 2.0 - 1.0;
    vec2 maxNDC = (maxPx / pc.screenSize) * 2.0 - 1.0;
    
    vec3 minNear = clipToView(vec4(minNDC.x, minNDC.y, 0.1, 1.0)).xyz; // Use 0.1 for Vulkan NDC depth range
    vec3 maxNear = clipToView(vec4(maxNDC.x, minNDC.y, 0.1, 1.0)).xyz;
    vec3 maxNearY = clipToView(vec4(minNDC.x, maxNDC.y, 0.1, 1.0)).xyz;
    vec3 maxNearXY = clipToView(vec4(maxNDC.x, maxNDC.y, 0.1, 1.0)).xyz;
    
    float sliceNear = pc.zNear * pow(pc.zFar / pc.zNear, float(gl_GlobalInvocationID.z) / float(pc.gridDimensions.z));
    float sliceFar  = pc.zNear * pow(pc.zFar / pc.zNear, float(gl_GlobalInvocationID.z + 1) / float(pc.gridDimensions.z));
    
    vec3 eyePos = vec3(0.0);
    vec3 p0 = lineIntersectionToZPlane(eyePos, minNear, -sliceNear).xyz;
    vec3 p1 = lineIntersectionToZPlane(eyePos, maxNear, -sliceNear).xyz;
    vec3 p2 = lineIntersectionToZPlane(eyePos, maxNearY, -sliceNear).xyz;
    vec3 p3 = lineIntersectionToZPlane(eyePos, maxNearXY, -sliceNear).xyz;
    
    vec3 p4 = lineIntersectionToZPlane(eyePos, minNear, -sliceFar).xyz;
    vec3 p5 = lineIntersectionToZPlane(eyePos, maxNear, -sliceFar).xyz;
    vec3 p6 = lineIntersectionToZPlane(eyePos, maxNearY, -sliceFar).xyz;
    vec3 p7 = lineIntersectionToZPlane(eyePos, maxNearXY, -sliceFar).xyz;
    
    vec3 minPoint = min(min(min(p0, p1), min(p2, p3)), min(min(p4, p5), min(p6, p7)));
    vec3 maxPoint = max(max(max(p0, p1), max(p2, p3)), max(max(p4, p5), max(p6, p7)));
    
    clusters[tileIndex].minPoint = vec4(minPoint, 1.0);
    clusters[tileIndex].maxPoint = vec4(maxPoint, 1.0);
}
