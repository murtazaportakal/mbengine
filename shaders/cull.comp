#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct InstanceData {
    mat4 world;
    vec4 aabbMin;
    vec4 aabbMax;
    vec4 color;
    vec4 pbr;
    uvec4 extra; // x: indexCount, y: firstIndex, z: vertexOffset, w: roughness (float bitcast)
};

struct VkDrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

struct PointLight {
    vec4 position;
    vec4 color;
};

layout(set = 0, binding = 0) uniform GlobalUbo {
    mat4 viewProj;
    mat4 lightSpaceMatrix;
    vec4 cameraPos;
    vec4 lightDir;
    vec4 lightColor;
    PointLight pointLights[4];
    uint numPointLights;
    uint pad0;
    uint pad1;
    uint pad2;
} ubo;

layout(set = 0, binding = 3) readonly buffer InstanceBuffer {
    InstanceData instances[];
};

layout(set = 0, binding = 2) writeonly buffer IndirectDrawBuffer {
    VkDrawIndexedIndirectCommand commands[];
};

// Atomic counter holding the number of visible (compacted) draw commands.
// MUST be reset to 0 by the CPU before each dispatch (see application.rs).
layout(set = 0, binding = 4) buffer DrawCountBuffer {
    uint drawCount;
};

layout(push_constant) uniform PushConstants {
    uint totalInstances;
    uint pad0;
    uint pad1;
    uint pad2;
} pc;

void main() {
    uint gID = gl_GlobalInvocationID.x;
    if (gID >= pc.totalInstances) return;

    InstanceData inst = instances[gID];

    // Get AABB corners in local space
    vec3 minP = inst.aabbMin.xyz;
    vec3 maxP = inst.aabbMax.xyz;

    // 8 corners of the AABB
    vec3 corners[8] = vec3[](
        vec3(minP.x, minP.y, minP.z),
        vec3(maxP.x, minP.y, minP.z),
        vec3(minP.x, maxP.y, minP.z),
        vec3(maxP.x, maxP.y, minP.z),
        vec3(minP.x, minP.y, maxP.z),
        vec3(maxP.x, minP.y, maxP.z),
        vec3(minP.x, maxP.y, maxP.z),
        vec3(maxP.x, maxP.y, maxP.z)
    );

    // Transform to world space and compute world AABB
    vec3 worldMin = vec3(1000000.0);
    vec3 worldMax = vec3(-1000000.0);
    for (int i = 0; i < 8; i++) {
        vec3 wc = (inst.world * vec4(corners[i], 1.0)).xyz;
        worldMin = min(worldMin, wc);
        worldMax = max(worldMax, wc);
    }
    
    vec3 worldCenter = (worldMin + worldMax) * 0.5;
    vec3 worldExtents = (worldMax - worldMin) * 0.5;

    // Extract frustum planes from View-Projection matrix
    mat4 vp = ubo.viewProj;
    vec4 planes[6];
    planes[0] = vec4(vp[0][3] + vp[0][0], vp[1][3] + vp[1][0], vp[2][3] + vp[2][0], vp[3][3] + vp[3][0]);
    planes[1] = vec4(vp[0][3] - vp[0][0], vp[1][3] - vp[1][0], vp[2][3] - vp[2][0], vp[3][3] - vp[3][0]);
    planes[2] = vec4(vp[0][3] + vp[0][1], vp[1][3] + vp[1][1], vp[2][3] + vp[2][1], vp[3][3] + vp[3][1]);
    planes[3] = vec4(vp[0][3] - vp[0][1], vp[1][3] - vp[1][1], vp[2][3] - vp[2][1], vp[3][3] - vp[3][1]);
    planes[4] = vec4(vp[0][3] + vp[0][2], vp[1][3] + vp[1][2], vp[2][3] + vp[2][2], vp[3][3] + vp[3][2]);
    planes[5] = vec4(vp[0][3] - vp[0][2], vp[1][3] - vp[1][2], vp[2][3] - vp[2][2], vp[3][3] - vp[3][2]);

    bool visible = true;
    for (int i = 0; i < 6; i++) {
        vec3 pNormal = planes[i].xyz;
        float pDist = planes[i].w;
        float len = length(pNormal);
        pNormal /= len;
        pDist /= len;
        
        // Compute effective radius of AABB projected onto plane normal
        float r = dot(worldExtents, abs(pNormal));
        float d = dot(pNormal, worldCenter) + pDist;
        
        if (d < -r) {
            visible = false;
            break;
        }
    }

    // Cull invisible instances: skip the draw command entirely.
    // Visible instances are compacted into the front of the command buffer
    // via an atomic counter so vkCmdDrawIndexedIndirect only issues real draws.
    if (!visible) {
        return;
    }

    // Atomically reserve a slot in the compacted command buffer.
    uint slot = atomicAdd(drawCount, 1);

    // extra.x = indexCount, extra.y = firstIndex, extra.z = vertexOffset
    commands[slot].indexCount = inst.extra.x;
    commands[slot].instanceCount = 1;
    commands[slot].firstIndex = inst.extra.y;
    commands[slot].vertexOffset = int(inst.extra.z);
    // firstInstance must point back to the original instance index so the
    // vertex shader can fetch the correct InstanceData via gl_InstanceIndex.
    commands[slot].firstInstance = gID;
}
