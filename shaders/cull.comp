#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct InstanceData {
    mat4 world;
    vec4 aabbMin;
    vec4 aabbMax;
    vec4 color;
    vec4 pbr;
    uvec4 extra; // x: indexCount, y: firstIndex, z: vertexOffset, w: emissive tex idx
    uvec4 geometry2; // x: meshletOffset, y: meshletCount, z: pad, w: pad
};

struct VkDrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

struct PointLight {
    vec4 position;
    vec4 color;
};

layout(set = 0, binding = 0) uniform GlobalUbo {
    mat4 viewProj;
    mat4 lightSpaceMatrix;
    vec4 cameraPos;
    vec4 lightDir;
    vec4 lightColor;
    PointLight pointLights[4];
    uint numPointLights;
    uint pad0;
    uint pad1;
    uint pad2;
} ubo;

layout(set = 0, binding = 3) buffer InstanceBuffer {
    InstanceData instances[];
};

layout(set = 0, binding = 2) writeonly buffer IndirectDrawBuffer {
    VkDrawIndexedIndirectCommand commands[];
};

layout(set = 0, binding = 4) buffer DrawCountBuffer {
    uint drawCount;
};

struct MeshletData {
    vec3 center;
    float radius;
    vec3 coneAxis;
    float coneCutoff;
    uint indexOffset;
    uint triangleCount;
    uint pad0;
    uint pad1;
};

layout(set = 0, binding = 5) readonly buffer MeshletBuffer {
    MeshletData meshlets[];
};

layout(set = 0, binding = 6) readonly buffer PrefixSumBuffer {
    uint prefixSum[];
};

// HZB from the previous frame - used for occlusion culling.
// Layout is GENERAL (desktop Vulkan allows sampling from GENERAL).
layout(set = 0, binding = 7) uniform sampler2D hzbSampler;

layout(push_constant) uniform PushConstants {
    uint totalMeshlets;
    uint totalInstances;
    uint debugCull;
    uint phase;
    float screenWidth;
    float screenHeight;
    float lodBias;
    float mipCount;
} pc;

layout(set = 0, binding = 8) buffer OccludedMeshletsBuffer {
    uint occludedMeshlets[];
};

layout(set = 0, binding = 9) buffer OccludedCountBuffer {
    uint occludedCount;
};

uint binary_search_instance(uint meshletIdx) {
    uint left = 0;
    uint right = pc.totalInstances - 1;
    uint result = 0;
    while (left <= right) {
        uint mid = left + (right - left) / 2;
        if (prefixSum[mid] <= meshletIdx) {
            result = mid;
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }
    return result;
}

void main() {
    uint gID;
    if (pc.phase == 1) {
        if (gl_GlobalInvocationID.x >= occludedCount) return;
        gID = occludedMeshlets[gl_GlobalInvocationID.x];
    } else {
        gID = gl_GlobalInvocationID.x;
        if (gID >= pc.totalMeshlets) return;
    }

    // 1. Find which instance this meshlet belongs to
    uint instanceIdx = binary_search_instance(gID);
    InstanceData inst = instances[instanceIdx];

    // 2. Fetch meshlet data
    uint localMeshletIdx = gID - prefixSum[instanceIdx];
    MeshletData meshlet = meshlets[inst.geometry2.x + localMeshletIdx];

    // 3. Transform meshlet bounding sphere to world space
    vec3 worldCenter = (inst.world * vec4(meshlet.center, 1.0)).xyz;
    float maxScale = max(max(length(inst.world[0].xyz), length(inst.world[1].xyz)), length(inst.world[2].xyz));
    float worldRadius = meshlet.radius * maxScale;

    // 4. Back-face cone culling
    // meshopt expects viewDir from camera to meshlet center
    vec3 coneAxisWorld = normalize(mat3(inst.world) * meshlet.coneAxis);
    vec3 viewDir = normalize(worldCenter - ubo.cameraPos.xyz);
    if (dot(coneAxisWorld, viewDir) > meshlet.coneCutoff) {
        return; // Entirely backfacing
    }

    // 5. Project bounding sphere to clip space for frustum + HZB + LOD tests
    //    Project sphere center + edge point to compute screen-space radius.
    vec4 clipCenter = ubo.viewProj * vec4(worldCenter, 1.0);

    bool visible = true;

    if (pc.debugCull == 0) {
        // 7. Frustum culling against 6 planes extracted from viewProj
        mat4 vp = ubo.viewProj;
        vec4 planes[6];
        planes[0] = vec4(vp[0][3] + vp[0][0], vp[1][3] + vp[1][0], vp[2][3] + vp[2][0], vp[3][3] + vp[3][0]);
        planes[1] = vec4(vp[0][3] - vp[0][0], vp[1][3] - vp[1][0], vp[2][3] - vp[2][0], vp[3][3] - vp[3][0]);
        planes[2] = vec4(vp[0][3] + vp[0][1], vp[1][3] + vp[1][1], vp[2][3] + vp[2][1], vp[3][3] + vp[3][1]);
        planes[3] = vec4(vp[0][3] - vp[0][1], vp[1][3] - vp[1][1], vp[2][3] - vp[2][1], vp[3][3] - vp[3][1]);
        planes[4] = vec4(vp[0][3] + vp[0][2], vp[1][3] + vp[1][2], vp[2][3] + vp[2][2], vp[3][3] + vp[3][2]);
        planes[5] = vec4(vp[0][3] - vp[0][2], vp[1][3] - vp[1][2], vp[2][3] - vp[2][2], vp[3][3] - vp[3][2]);

        for (int p = 0; p < 6; p++) {
            float len = length(planes[p].xyz);
            planes[p] /= len;
            float dist = dot(planes[p].xyz, worldCenter) + planes[p].w;
            if (dist < -worldRadius) {
                visible = false;
                break;
            }
        }
    }

    if (!visible) return;

    // 6. & 8. Screen-space tests (LOD and HZB)
    if (pc.debugCull == 0 && clipCenter.w > worldRadius) {
        float invW = 1.0 / clipCenter.w;
        vec3 ndcCenter = clipCenter.xyz * invW;

        vec3 viewForward = worldCenter - ubo.cameraPos.xyz;
        float distToCenter = length(viewForward);
        if (distToCenter > 0.0) {
            viewForward /= distToCenter;
        } else {
            viewForward = vec3(0.0, 0.0, 1.0);
        }

        vec3 upRef = abs(viewForward.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3 camRight = normalize(cross(viewForward, upRef));
        
        vec4 edgeClip = ubo.viewProj * vec4(worldCenter + camRight * worldRadius, 1.0);
        float edgeNdcX = edgeClip.x / edgeClip.w;
        float screenRadius = abs(edgeNdcX - ndcCenter.x) * pc.screenWidth * 0.5;

        if (screenRadius < pc.lodBias) {
            return; 
        }

        // HZB Occlusion Test
        // Convert screen center to UV [0, 1]
        vec2 uv = ndcCenter.xy * 0.5 + 0.5;

        // Bounding box size in UV space
        vec2 uvRadius = vec2(screenRadius / pc.screenWidth, screenRadius / pc.screenHeight);
        
        // Calculate Mip Level
        float maxRadius = max(uvRadius.x, uvRadius.y) * 2.0; // Box diameter
        float lod = ceil(log2(max(maxRadius * pc.screenWidth, maxRadius * pc.screenHeight)));
        lod = clamp(lod, 0.0, pc.mipCount - 1.0);

        // Fetch depth from 4 texels at the computed LOD
        vec2 minUV = uv - uvRadius;
        vec2 maxUV = uv + uvRadius;

        float d1 = textureLod(hzbSampler, minUV, lod).x;
        float d2 = textureLod(hzbSampler, vec2(maxUV.x, minUV.y), lod).x;
        float d3 = textureLod(hzbSampler, vec2(minUV.x, maxUV.y), lod).x;
        float d4 = textureLod(hzbSampler, maxUV, lod).x;

        // Min depth among the 4 texels
        float maxDepth = max(max(d1, d2), max(d3, d4)); // Reverse-Z, min is max

        // Project the meshlet bounding sphere backmost point to get its minimum depth
        vec4 backClip = ubo.viewProj * vec4(worldCenter - viewForward * worldRadius, 1.0);
        float backDepth = backClip.z / backClip.w;

        // If the meshlet is strictly deeper than the max depth of the bounding area in HZB, it is occluded
        if (backDepth > maxDepth) { // Standard-Z: further objects have LARGER z values
            visible = false;
        }
    }

    if (!visible) {
        if (pc.phase == 0 && pc.debugCull == 0) {
            uint idx = atomicAdd(occludedCount, 1);
            occludedMeshlets[idx] = gID;
        }
        return;
    }

    // Atomically reserve a slot in the compacted command buffer.
    uint slot = atomicAdd(drawCount, 1);

    commands[slot].indexCount = meshlet.triangleCount * 3;
    commands[slot].instanceCount = 1;
    commands[slot].firstIndex = inst.extra.y + meshlet.indexOffset;
    commands[slot].vertexOffset = int(inst.extra.z);
    commands[slot].firstInstance = instanceIdx;
}
