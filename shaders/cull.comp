#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct InstanceData {
    mat4 world;
    vec4 aabbMin;
    vec4 aabbMax;
    vec4 color;
    vec4 pbr;
    uvec4 extra; // x: indexCount, y: firstIndex, z: vertexOffset, w: emissive tex idx
    uvec4 geometry2; // x: meshletOffset, y: meshletCount, z: pad, w: pad
};

struct VkDrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

struct PointLight {
    vec4 position;
    vec4 color;
};

layout(set = 0, binding = 0) uniform GlobalUbo {
    mat4 viewProj;
    mat4 prevViewProj;
    mat4 view;
    mat4 proj;
    mat4 inverseProj;
    mat4 lightSpaceMatrix;
    vec4 cameraPos;
    vec4 lightDir;
    vec4 lightColor;
    vec2 screenSize;
    float zNear;
    float zFar;
    uint numPointLights;
    uint debugMeshlets;
    uvec2 _pad0;
    uint64_t vertexBufferAddr;
} ubo;

layout(set = 0, binding = 3) buffer InstanceBuffer {
    InstanceData instances[];
};

layout(set = 0, binding = 2) writeonly buffer IndirectDrawBuffer {
    VkDrawIndexedIndirectCommand commands[];
};

layout(set = 0, binding = 4) buffer DrawCountBuffer {
    uint drawCount;
};

struct MeshletData {
    vec3 center;
    float radius;
    vec3 coneAxis;
    float coneCutoff;
    uint indexOffset;
    uint triangleCount;
    uint pad0;
    uint pad1;
};

layout(set = 0, binding = 5) readonly buffer MeshletBuffer {
    MeshletData meshlets[];
};

layout(set = 0, binding = 6) readonly buffer PrefixSumBuffer {
    uint prefixSum[];
};

// HZB from the previous frame - used for occlusion culling.
// Layout is GENERAL (desktop Vulkan allows sampling from GENERAL).
layout(set = 0, binding = 7) uniform sampler2D hzbSampler;

layout(push_constant) uniform PushConstants {
    uint totalMeshlets;
    uint totalInstances;
    uint debugCull;
    uint phase;
    float screenWidth;
    float screenHeight;
    float lodBias;
    float mipCount;
} pc;

layout(set = 0, binding = 8) buffer OccludedMeshletsBuffer {
    uint occludedMeshlets[];
};

layout(set = 0, binding = 9) buffer OccludedCountBuffer {
    uint occludedCount;
};

uint binary_search_instance(uint meshletIdx) {
    uint left = 0;
    uint right = pc.totalInstances - 1;
    uint result = 0;
    while (left <= right) {
        uint mid = left + (right - left) / 2;
        if (prefixSum[mid] <= meshletIdx) {
            result = mid;
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }
    return result;
}

void main() {
    uint gID;
    if (pc.phase == 1) {
        if (gl_GlobalInvocationID.x >= occludedCount) return;
        gID = occludedMeshlets[gl_GlobalInvocationID.x];
    } else {
        gID = gl_GlobalInvocationID.x;
        if (gID >= pc.totalMeshlets) return;
    }

    // 1. Find which instance this meshlet belongs to
    uint instanceIdx = binary_search_instance(gID);
    InstanceData inst = instances[instanceIdx];

    // 2. Fetch meshlet data
    uint localMeshletIdx = gID - prefixSum[instanceIdx];
    MeshletData meshlet = meshlets[inst.geometry2.x + localMeshletIdx];

    // 3. Transform meshlet bounding sphere to world space
    vec3 worldCenter = (inst.world * vec4(meshlet.center, 1.0)).xyz;
    float maxScale = max(max(length(inst.world[0].xyz), length(inst.world[1].xyz)), length(inst.world[2].xyz));
    float worldRadius = meshlet.radius * maxScale * 1.2;

    // 4. Back-face cone culling (TEMPORARILY DISABLED FOR TESTING)
    bool visible = true;
    bool isAnimated = inst.geometry2.z != 0xFFFFFFFF;
    /*
    if (!isAnimated && meshlet.coneCutoff < 1.0) { // Disabled for animated meshes because cone is static
        vec3 coneAxis = normalize((inst.world * vec4(meshlet.coneAxis, 0.0)).xyz);
        vec3 view = worldCenter - ubo.cameraPos.xyz;
        if (dot(coneAxis, normalize(view)) >= meshlet.coneCutoff && dot(view, view) > worldRadius * worldRadius) {
            visible = false;
        }
    }
    */

    // 5. & 6. & 7. & 8. Frustum & HZB Culling
    if (visible && pc.debugCull == 0 && !isAnimated) {
        float r = worldRadius;
        vec3 corners[8] = vec3[8](
            worldCenter + vec3(-r, -r, -r),
            worldCenter + vec3( r, -r, -r),
            worldCenter + vec3(-r,  r, -r),
            worldCenter + vec3( r,  r, -r),
            worldCenter + vec3(-r, -r,  r),
            worldCenter + vec3( r, -r,  r),
            worldCenter + vec3(-r,  r,  r),
            worldCenter + vec3( r,  r,  r)
        );

        // Project against CURRENT frame's viewProj for Frustum Culling
        vec3 minFrustumNDC = vec3(9999.0);
        vec3 maxFrustumNDC = vec3(-9999.0);
        bool frustumValid = true;

        for (int i = 0; i < 8; i++) {
            vec4 clip = ubo.viewProj * vec4(corners[i], 1.0);
            if (clip.w > 0.001) {
                vec3 ndc = clip.xyz / clip.w;
                minFrustumNDC = min(minFrustumNDC, ndc);
                maxFrustumNDC = max(maxFrustumNDC, ndc);
            } else {
                // If any corner is behind the camera, the AABB crosses the near plane.
                // In this case, it might be visible and span the whole screen.
                minFrustumNDC = vec3(-1.0, -1.0, 0.0);
                maxFrustumNDC = vec3(1.0, 1.0, 1.0);
                frustumValid = false;
                break;
            }
        }

        // Frustum culling test
        if (maxFrustumNDC.x < -1.0 || minFrustumNDC.x > 1.0 ||
            maxFrustumNDC.y < -1.0 || minFrustumNDC.y > 1.0 ||
            maxFrustumNDC.z <  0.0 || minFrustumNDC.z > 1.0) {
            visible = false;
        }

        // HZB Culling
        if (visible && pc.mipCount > 0.0) {
            mat4 hzbViewProj = (pc.phase == 0) ? ubo.prevViewProj : ubo.viewProj;
            vec2 minUV = vec2(1.0);
            vec2 maxUV = vec2(0.0);
            float minZ = 1.0;
            float maxZ = 0.0;  // Track max NDC Z for bias computation
            bool hzbValid = true;

            for (int i = 0; i < 8; ++i) {
                vec4 clip = hzbViewProj * vec4(corners[i], 1.0);
                if (clip.w > 0.001) {
                    vec3 ndc = clip.xyz / clip.w;
                    vec2 uv = ndc.xy * 0.5 + 0.5;
                    minUV = min(minUV, uv);
                    maxUV = max(maxUV, uv);
                    minZ = min(minZ, ndc.z);
                    maxZ = max(maxZ, ndc.z);
                } else {
                    hzbValid = false;
                    break;
                }
            }

            if (hzbValid) {
                // CLAMP UVs TO SCREEN VISIBLE AREA
                minUV = clamp(minUV, vec2(0.0), vec2(1.0));
                maxUV = clamp(maxUV, vec2(0.0), vec2(1.0));
                
                // Calculate bounding box size in original screen pixels (before HZB scaling)
                float w = (maxUV.x - minUV.x) * pc.screenWidth;
                float h = (maxUV.y - minUV.y) * pc.screenHeight;

                // Mip 0 size is the next power of two of half the screen size
                float hzbWidth = exp2(ceil(log2(max(1.0, pc.screenWidth / 2.0))));
                float hzbHeight = exp2(ceil(log2(max(1.0, pc.screenHeight / 2.0))));
                float lod = ceil(log2(max(max(w, h), 1.0)));
                lod = clamp(lod, 0.0, pc.mipCount - 1.0);

                // Calculate exact active region size at this lod
                float activeWidth = floor(pc.screenWidth / 2.0);
                float activeHeight = floor(pc.screenHeight / 2.0);
                for (int i = 0; i < int(lod); ++i) {
                    activeWidth = max(1.0, floor(activeWidth / 2.0));
                    activeHeight = max(1.0, floor(activeHeight / 2.0));
                }

                // Mip level full dimension
                float mipWidth = max(1.0, hzbWidth / exp2(lod));
                float mipHeight = max(1.0, hzbHeight / exp2(lod));
                
                vec2 hzbScale = vec2(activeWidth / mipWidth, activeHeight / mipHeight);
                
                vec2 sampleMinUV = minUV * hzbScale;
                vec2 sampleMaxUV = maxUV * hzbScale;

                // Expand by 0.2 texels to account for floating point precision and rasterization rules.
                vec2 texelSize = vec2(1.0) / vec2(mipWidth, mipHeight);
                sampleMinUV -= 0.2 * texelSize;
                sampleMaxUV += 0.2 * texelSize;

                // Clamp to the center of the last valid texel to avoid reading padding
                vec2 maxValidUV = vec2(
                    max(0.0, activeWidth - 0.5) / mipWidth,
                    max(0.0, activeHeight - 0.5) / mipHeight
                );
                
                sampleMinUV = clamp(sampleMinUV, vec2(0.0), maxValidUV);
                sampleMaxUV = clamp(sampleMaxUV, vec2(0.0), maxValidUV);

                float d1 = textureLod(hzbSampler, sampleMinUV, lod).x;
                float d2 = textureLod(hzbSampler, vec2(sampleMaxUV.x, sampleMinUV.y), lod).x;
                float d3 = textureLod(hzbSampler, vec2(sampleMinUV.x, sampleMaxUV.y), lod).x;
                float d4 = textureLod(hzbSampler, sampleMaxUV, lod).x;

                float maxDepth = max(max(d1, d2), max(d3, d4));

                // Conservative depth bias:
                // - Base: 0.001 to handle floating point imprecision
                // - Sphere depth extent (maxZ - minZ): accounts for camera movement temporal
                //   reprojection error. When the camera moves, the sphere's NDC depth range
                //   tells us how wrong the depth comparison could be. This prevents small
                //   objects (like eyeballs inside a head) from being falsely occluded.
                // - Phase 0 (prev-frame HZB) needs the full extent as bias.
                //   Phase 1 (current-frame HZB) is exact, so just a tiny epsilon.
                float sphereDepthExtent = maxZ - minZ;
                float bias = (pc.phase == 0)
                    ? max(0.001, sphereDepthExtent)
                    : 0.001;

                if (minZ > maxDepth + bias) {
                    visible = false;
                }
            }
        }
    }

    // visible = true; // [DEBUG] FORCE ALL MESHLETS VISIBLE

    if (!visible) {
        if (pc.phase == 0 && pc.debugCull == 0) {
            uint idx = atomicAdd(occludedCount, 1);
            occludedMeshlets[idx] = gID;
        }
        return;
    }

    // Atomically reserve a slot in the compacted command buffer.
    uint slot = atomicAdd(drawCount, 1);

    commands[slot].indexCount = meshlet.triangleCount * 3;
    commands[slot].instanceCount = 1;
    commands[slot].firstIndex = inst.extra.y + meshlet.indexOffset;
    commands[slot].vertexOffset = int(inst.extra.z);
    commands[slot].firstInstance = instanceIdx;
}
