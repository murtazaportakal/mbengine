#version 450

// HZB mip generation � 2x2 max-depth reduction of the source depth/color.
// Each 8x8 threadgroup writes one 8x8 tile of the destination mip.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Source image (depth buffer for mip 0, previous HZB mip for subsequent levels).
// For depth buffers we use R32_SFLOAT copy; the depth image must be blit-copied
// to an R32_SFLOAT image before this pass (see backend.rs).
layout(set = 0, binding = 0) uniform sampler2D srcImage;

// Destination mip (storage image write target, R32_SFLOAT).
layout(set = 0, binding = 1, r32f) uniform writeonly image2D dstImage;

layout(set = 0, binding = 2) uniform HzbParams {
    uint srcWidth;
    uint srcHeight;
    uint dstWidth;
    uint dstHeight;
};

void main() {
    ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);
    if (dstCoord.x >= int(dstWidth) || dstCoord.y >= int(dstHeight)) return;

    // Sample 4 texels from the source at 2x resolution.
    // Using explicit unnormalized texel fetches for exact coverage.
        ivec2 srcCoord00 = dstCoord * 2;
    ivec2 srcCoord10 = min(srcCoord00 + ivec2(1, 0), ivec2(srcWidth - 1, srcHeight - 1));
    ivec2 srcCoord01 = min(srcCoord00 + ivec2(0, 1), ivec2(srcWidth - 1, srcHeight - 1));
    ivec2 srcCoord11 = min(srcCoord00 + ivec2(1, 1), ivec2(srcWidth - 1, srcHeight - 1));

    float d00 = texelFetch(srcImage, srcCoord00, 0).r;
    float d10 = texelFetch(srcImage, srcCoord10, 0).r;
    float d01 = texelFetch(srcImage, srcCoord01, 0).r;
    float d11 = texelFetch(srcImage, srcCoord11, 0).r;

    // Conservative: take the MAXIMUM depth (farthest from camera).
    // An occluded meshlet's depth must be GREATER than all 4 samples to be culled.
    float maxDepth = max(max(d00, d10), max(d01, d11));

    // If source dimensions are odd, the last destination pixel must also cover the extra source pixel
    bool extraX = (dstCoord.x == int(dstWidth) - 1) && ((srcWidth & 1) != 0);
    bool extraY = (dstCoord.y == int(dstHeight) - 1) && ((srcHeight & 1) != 0);

    if (extraX) {
        float dx0 = texelFetch(srcImage, ivec2(srcWidth - 1, srcCoord00.y), 0).r;
        float dx1 = texelFetch(srcImage, ivec2(srcWidth - 1, srcCoord01.y), 0).r;
        maxDepth = max(maxDepth, max(dx0, dx1));
    }
    if (extraY) {
        float dy0 = texelFetch(srcImage, ivec2(srcCoord00.x, srcHeight - 1), 0).r;
        float dy1 = texelFetch(srcImage, ivec2(srcCoord10.x, srcHeight - 1), 0).r;
        maxDepth = max(maxDepth, max(dy0, dy1));
    }
    if (extraX && extraY) {
        float dxy = texelFetch(srcImage, ivec2(srcWidth - 1, srcHeight - 1), 0).r;
        maxDepth = max(maxDepth, dxy);
    }

    imageStore(dstImage, dstCoord, vec4(maxDepth, 0.0, 0.0, 0.0));
}
