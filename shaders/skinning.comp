#version 450

layout(local_size_x = 256) in;

// ── Vertex layout (matches Rust Vertex struct) ──────────────────────────────
struct InputVertex {
    vec3 pos;       // offset  0
    vec3 normal;    // offset 12
    vec2 uv;        // offset 24
    uvec4 joints;   // offset 32
    vec4 weights;   // offset 48
};                  // total: 64 bytes

struct OutputVertex {
    vec3 pos;       // offset  0
    vec3 normal;    // offset 12
    vec2 uv;        // offset 24
    uvec4 joints;   // offset 32 (pass-through)
    vec4 weights;   // offset 48 (pass-through)
};                  // total: 64 bytes

// ── Bindings ────────────────────────────────────────────────────────────────

// Bone matrices (model-space), up to MAX_BONES
layout(std430, binding = 0) readonly buffer BoneMatrices {
    mat4 boneMatrices[128];
};

// Original (bind-pose) vertex data
layout(std430, binding = 1) readonly buffer InputVertices {
    float inputData[];
};

// Skinned (deformed) vertex data — same layout, written by this shader
layout(std430, binding = 2) writeonly buffer OutputVertices {
    float outputData[];
};

// ── Push Constants ──────────────────────────────────────────────────────────
layout(push_constant) uniform PushConstants {
    uint vertexCount;
} pc;

// Helper: read a vec3 from the flat float array at the given float-index offset
vec3 readVec3(uint baseFloat) {
    return vec3(inputData[baseFloat], inputData[baseFloat + 1], inputData[baseFloat + 2]);
}

vec2 readVec2(uint baseFloat) {
    return vec2(inputData[baseFloat], inputData[baseFloat + 1]);
}

uvec4 readUVec4(uint baseFloat) {
    return uvec4(
        floatBitsToUint(inputData[baseFloat]),
        floatBitsToUint(inputData[baseFloat + 1]),
        floatBitsToUint(inputData[baseFloat + 2]),
        floatBitsToUint(inputData[baseFloat + 3])
    );
}

vec4 readVec4(uint baseFloat) {
    return vec4(inputData[baseFloat], inputData[baseFloat + 1], inputData[baseFloat + 2], inputData[baseFloat + 3]);
}

void writeVec3(uint baseFloat, vec3 v) {
    outputData[baseFloat]     = v.x;
    outputData[baseFloat + 1] = v.y;
    outputData[baseFloat + 2] = v.z;
}

void writeVec2(uint baseFloat, vec2 v) {
    outputData[baseFloat]     = v.x;
    outputData[baseFloat + 1] = v.y;
}

void writeUVec4(uint baseFloat, uvec4 v) {
    outputData[baseFloat]     = uintBitsToFloat(v.x);
    outputData[baseFloat + 1] = uintBitsToFloat(v.y);
    outputData[baseFloat + 2] = uintBitsToFloat(v.z);
    outputData[baseFloat + 3] = uintBitsToFloat(v.w);
}

void writeVec4(uint baseFloat, vec4 v) {
    outputData[baseFloat]     = v.x;
    outputData[baseFloat + 1] = v.y;
    outputData[baseFloat + 2] = v.z;
    outputData[baseFloat + 3] = v.w;
}

void main() {
    uint vertexIndex = gl_GlobalInvocationID.x;
    if (vertexIndex >= pc.vertexCount) {
        return;
    }

    // Each vertex is 16 floats (64 bytes / 4 = 16 floats)
    uint stride = 16;
    uint base = vertexIndex * stride;

    // Read input vertex
    vec3 pos    = readVec3(base + 0);
    vec3 normal = readVec3(base + 3);
    vec2 uv     = readVec2(base + 6);
    uvec4 joints = readUVec4(base + 8);
    vec4 weights = readVec4(base + 12);

    // Apply bone skinning: weighted sum of bone transforms
    float totalWeight = weights.x + weights.y + weights.z + weights.w;

    vec3 skinnedPos;
    vec3 skinnedNormal;

    if (totalWeight > 0.0001) {
        mat4 skinMatrix = 
            weights.x * boneMatrices[joints.x] +
            weights.y * boneMatrices[joints.y] +
            weights.z * boneMatrices[joints.z] +
            weights.w * boneMatrices[joints.w];

        skinnedPos    = (skinMatrix * vec4(pos, 1.0)).xyz;
        skinnedNormal = mat3(skinMatrix) * normal;
    } else {
        // No bone influence — pass through unchanged
        skinnedPos    = pos;
        skinnedNormal = normal;
    }

    // Write output vertex (same layout)
    writeVec3(base + 0, skinnedPos);
    writeVec3(base + 3, normalize(skinnedNormal));
    writeVec2(base + 6, uv);
    writeUVec4(base + 8, joints);
    writeVec4(base + 12, weights);
}
