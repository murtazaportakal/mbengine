#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) buffer MeshVertices {
    float vertexData[];
};

layout(push_constant) uniform PushConstants {
    uint grid_width;
    uint grid_height;
} pc;

vec3 readPos(uint idx) {
    uint base = idx * 16;
    return vec3(vertexData[base], vertexData[base + 1], vertexData[base + 2]);
}

void writeNormal(uint idx, vec3 n) {
    uint base = idx * 16;
    vertexData[base + 3] = n.x;
    vertexData[base + 4] = n.y;
    vertexData[base + 5] = n.z;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    if (x >= pc.grid_width || y >= pc.grid_height) {
        return;
    }

    uint idx = y * pc.grid_width + x;
    vec3 p = readPos(idx);

    vec3 n = vec3(0.0);
    int count = 0;

    if (x > 0 && y > 0) {
        vec3 p1 = readPos(idx - 1);
        vec3 p2 = readPos(idx - pc.grid_width);
        n += cross(p1 - p, p2 - p);
        count++;
    }
    if (x < pc.grid_width - 1 && y > 0) {
        vec3 p1 = readPos(idx - pc.grid_width);
        vec3 p2 = readPos(idx + 1);
        n += cross(p1 - p, p2 - p);
        count++;
    }
    if (x < pc.grid_width - 1 && y < pc.grid_height - 1) {
        vec3 p1 = readPos(idx + 1);
        vec3 p2 = readPos(idx + pc.grid_width);
        n += cross(p1 - p, p2 - p);
        count++;
    }
    if (x > 0 && y < pc.grid_height - 1) {
        vec3 p1 = readPos(idx + pc.grid_width);
        vec3 p2 = readPos(idx - 1);
        n += cross(p1 - p, p2 - p);
        count++;
    }

    if (count > 0) {
        n = normalize(n);
    } else {
        n = vec3(0.0, 1.0, 0.0);
    }

    writeNormal(idx, n);
}
